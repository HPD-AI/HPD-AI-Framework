{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@hpd/gateway-client": ["../../../hpd-gateway-client/src/index.ts"],
      "@hpd/gateway-client/studio-host": ["../../../hpd-gateway-client/src/studio-host.ts"],
      "@hpd-research/hpd-studio-core": ["../../../hpd-studio-core/src/index.ts"]
    },
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
