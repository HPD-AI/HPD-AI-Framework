{
  "name": "@hpd/base-client",
  "version": "0.2.0",
  "description": "Typed reactive client for the HPD Base v2 application protocol.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test browser-test/*.test.mjs",
    "check": "npm run test && npm run test:browser"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "typescript": "7.0.2"
  },
  "license": "FSL-1.1-ALv2"
}
