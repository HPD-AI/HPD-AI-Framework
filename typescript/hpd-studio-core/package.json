{
  "name": "@hpd-research/hpd-studio-core",
  "private": true,
  "version": "0.1.0",
  "description": "Product-neutral module composition runtime for HPD Studio.",
  "type": "module",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./boundary": {
      "svelte": "./src/StudioModuleBoundary.svelte",
      "import": "./src/StudioModuleBoundary.svelte"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "svelte-check --tsgo --tsconfig ./tsconfig.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "license": "FSL-1.1-ALv2",
  "dependencies": {
    "@hpd/base-client": "file:../hpd-base-client",
    "@noble/hashes": "2.3.0"
  }
}
