{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "declaration": true,
    "outDir": "./dist", "rootDir": "./src", "strict": true,
    "noImplicitAny": true, "strictNullChecks": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "skipLibCheck": true,
    "isolatedModules": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*"], "exclude": ["node_modules", "dist", "__tests__"]
}
