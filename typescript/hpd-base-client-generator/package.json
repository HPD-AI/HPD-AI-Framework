{
  "name": "@hpd/base-client-generator",
  "version": "0.2.0",
  "description": "Deterministic HPD Base generation-snapshot v2 TypeScript emitter.",
  "type": "module",
  "bin": { "hpd-base-client": "./dist/cli.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run test"
  },
  "sideEffects": false,
  "engines": { "node": ">=24" },
  "dependencies": { "typescript": "7.0.2" },
  "devDependencies": { "@types/node": "^24.0.0", "@hpd/base-client": "file:../hpd-base-client" },
  "license": "FSL-1.1-ALv2"
}
