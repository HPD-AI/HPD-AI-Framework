    <ProjectReference Include="..\HPD.ML.DeepLearning\HPD.ML.DeepLearning.csproj" />
    <ProjectReference Include="../../../../../../../../HPD-Math-Framework/Helium/src/Helium.Hardware/Helium.Hardware.csproj" />
    <ProjectReference Include="../../../../../../../../HPD-Math-Framework/Helium/src/Helium.MLX/Helium.MLX.csproj" />
    <ProjectReference Include="../../../../../../../../HPD-Math-Framework/Helium/src/Helium.PJRT/Helium.PJRT.csproj" />
  </ItemGroup>

</Project>
