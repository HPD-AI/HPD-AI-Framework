<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>HPD.ML.Studio</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.ML.Studio</PackageId>
    <Description>HPD ML Studio module package for HPD AI Studio.</Description>
    <PackageTags>ml;models;training;evaluation;studio;svelte</PackageTags>
    <StudioMlModuleRoot>$(MSBuildThisFileDirectory)..\..\..\..\typescript\hpd-ai-studio\modules\hpd-ml-studio\</StudioMlModuleRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HPD-AI.Studio\HPD-AI.Studio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(StudioMlModuleRoot)**\*" Exclude="$(StudioMlModuleRoot)node_modules\**\*;$(StudioMlModuleRoot)dist\**\*" Pack="true" PackagePath="clientapp-modules\hpd-ml-studio\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
