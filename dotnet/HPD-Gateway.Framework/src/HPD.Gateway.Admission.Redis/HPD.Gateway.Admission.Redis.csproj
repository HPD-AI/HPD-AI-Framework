<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Gateway.Admission.Redis</RootNamespace>
    <AssemblyName>HPD.Gateway.Admission.Redis</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Gateway.Admission.Redis</PackageId>
    <Description>Governed Redis-compatible deployment admission for HPD.Gateway.</Description>
    <PackageTags>hpd;gateway;redis;valkey;rate-limiting;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
    <ProjectReference Include="../HPD.Gateway/HPD.Gateway.csproj" />
  </ItemGroup>
</Project>
