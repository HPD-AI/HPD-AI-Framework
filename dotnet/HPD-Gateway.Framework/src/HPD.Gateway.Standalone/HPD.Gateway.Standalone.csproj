<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Gateway.Standalone</RootNamespace>
    <AssemblyName>HPD.Gateway.Standalone</AssemblyName>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Gateway/HPD.Gateway.csproj" />
    <ProjectReference Include="../HPD.Gateway.Abstractions/HPD.Gateway.Abstractions.csproj" />
    <ProjectReference Include="../HPD.Gateway.Hosting/HPD.Gateway.Hosting.csproj" />
    <ProjectReference Include="../HPD.Gateway.OutputCaching/HPD.Gateway.OutputCaching.csproj" />
    <ProjectReference Include="../HPD.Gateway.Resilience/HPD.Gateway.Resilience.csproj" />
  </ItemGroup>
</Project>
