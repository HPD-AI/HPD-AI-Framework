<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Gateway.Management</RootNamespace>
    <AssemblyName>HPD.Gateway.Management</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Gateway.Management</PackageId>
    <Description>Provider-neutral local managed authority for HPD.Gateway over HPD.Base.</Description>
    <PackageTags>hpd;gateway;management;authority;base;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup Condition="'$(UsePublishedHpdDependencies)' != 'true'">
    <ProjectReference Include="../../../HPD-Base.Framework/src/HPD.Base/HPD.Base.csproj" />
    <ProjectReference Include="../../../HPD-Base.Framework/src/HPD.Base.Generators/HPD.Base.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedHpdDependencies)' == 'true'">
    <PackageReference Include="HPD.Base" Version="$(HPDBaseVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Gateway.Abstractions/HPD.Gateway.Abstractions.csproj" />
    <ProjectReference Include="../HPD.Gateway.Core/HPD.Gateway.Core.csproj" />
    <ProjectReference Include="../HPD.Gateway/HPD.Gateway.csproj" />
    <ProjectReference Include="../HPD.Gateway.Yarp/HPD.Gateway.Yarp.csproj" />
  </ItemGroup>
</Project>
