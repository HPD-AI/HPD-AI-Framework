<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Gateway.Admin</RootNamespace>
    <AssemblyName>HPD.Gateway.Admin</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Gateway.Admin</PackageId>
    <Description>Secured bounded local Admin API for HPD.Gateway.</Description>
    <PackageTags>hpd;gateway;admin;aspnetcore;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <ProjectReference Include="../HPD.Gateway.Abstractions/HPD.Gateway.Abstractions.csproj" />
    <ProjectReference Include="../HPD.Gateway.Core/HPD.Gateway.Core.csproj" />
    <ProjectReference Include="../HPD.Gateway.Management/HPD.Gateway.Management.csproj" />
    <ProjectReference Include="../HPD.Gateway.Status/HPD.Gateway.Status.csproj" />
    <ProjectReference Include="../HPD.Gateway.Effective/HPD.Gateway.Effective.csproj" />
    <ProjectReference Include="../HPD.Gateway.Hosting/HPD.Gateway.Hosting.csproj" />
  </ItemGroup>
</Project>
