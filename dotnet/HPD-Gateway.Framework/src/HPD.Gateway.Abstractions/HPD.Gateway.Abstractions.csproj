<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Gateway.Abstractions</RootNamespace>
    <AssemblyName>HPD.Gateway.Abstractions</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Gateway.Abstractions</PackageId>
    <Description>Stable, Native AOT-oriented declarations and results for HPD.Gateway.</Description>
    <PackageTags>hpd;gateway;yarp;aspnetcore;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
</Project>
