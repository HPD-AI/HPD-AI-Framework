<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Gateway.ControlPlane.HPDAuth</RootNamespace>
    <AssemblyName>HPD.Gateway.ControlPlane.HPDAuth</AssemblyName>
    <PackageId>HPD.Gateway.ControlPlane.HPDAuth</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Optional HPD.Auth attribution and endpoint-security translation for the HPD Gateway control plane.</Description>
    <PackageTags>hpd;gateway;control-plane;auth;aspnetcore;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Gateway.ControlPlane/HPD.Gateway.ControlPlane.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedHpdDependencies)' != 'true'">
    <ProjectReference Include="../../../HPD-Auth.Framework/src/HPD.Auth.ControlPlane.AspNetCore/HPD.Auth.ControlPlane.AspNetCore.csproj" />
    <ProjectReference Include="../../../HPD-Auth.Framework/src/HPD.Auth.Core/HPD.Auth.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UsePublishedHpdDependencies)' == 'true'">
    <PackageReference Include="HPD-Auth-ControlPlane-AspNetCore" Version="$(HPDAuthVersion)" />
    <PackageReference Include="HPD-Auth-Core" Version="$(HPDAuthVersion)" />
  </ItemGroup>
</Project>
