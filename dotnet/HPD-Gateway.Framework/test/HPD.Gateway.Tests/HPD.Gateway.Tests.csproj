    <ProjectReference Include="../../src/HPD.Gateway.ControlPlane.HPDAuth/HPD.Gateway.ControlPlane.HPDAuth.csproj" />
    <ProjectReference Include="../../../HPD-Auth.Framework/src/HPD.Auth.Audit/HPD.Auth.Audit.csproj" />
    <ProjectReference Include="../../src/HPD.Gateway.Standalone/HPD.Gateway.Standalone.csproj" />
    <ProjectReference Include="../../../HPD-Base.Framework/src/HPD.Base.Sqlite/HPD.Base.Sqlite.csproj" />
  </ItemGroup>
</Project>
