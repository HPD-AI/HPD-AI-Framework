<Project>
  <Import Project="../Directory.Build.props" />

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Observability/*.cs" Link="Shared/Observability/%(Filename)%(Extension)" />
    <PackageReference
      Include="Microsoft.Extensions.Logging.Abstractions"
      Version="10.0.9"
      Condition="'$(MSBuildProjectName)' != 'HPD.Base.Auth.HPDAuth.AspNetCore.Tests'" />
  </ItemGroup>
</Project>
