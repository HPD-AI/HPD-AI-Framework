<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Base.Realtime.AspNetCore</RootNamespace>
    <AssemblyName>HPD.Base.Realtime.AspNetCore</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Base.Realtime.AspNetCore</PackageId>
    <Description>ASP.NET Core WebSocket transport for HPD.BASE realtime event feeds.</Description>
    <PackageTags>hpd;base;realtime;websocket;aspnetcore;openapi;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../HPD.Base.AspNetCore/HPD.Base.AspNetCore.csproj" />
    <ProjectReference Include="../HPD.Base.Realtime/HPD.Base.Realtime.csproj" />
  </ItemGroup>
</Project>
