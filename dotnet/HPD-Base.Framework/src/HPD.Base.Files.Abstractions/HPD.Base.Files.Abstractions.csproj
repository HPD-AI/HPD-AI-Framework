<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Base.Files</RootNamespace>
    <AssemblyName>HPD.Base.Files.Abstractions</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Base.Files.Abstractions</PackageId>
    <Description>Portable HPD.BASE file/object storage contracts, DTOs, provider interfaces, policy seam, and AOT-safe JSON metadata.</Description>
    <PackageTags>hpd;base;files;storage;abstractions;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD.Base.Abstractions/HPD.Base.Abstractions.csproj" />
  </ItemGroup>
</Project>
