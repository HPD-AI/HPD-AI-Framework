<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Base.LiveQuery</RootNamespace>
    <AssemblyName>HPD.Base.LiveQuery</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Base.LiveQuery</PackageId>
    <Description>In-process dependency-driven query rerun coordination for HPD.BASE hosts.</Description>
    <PackageTags>hpd;base;live-query;dependencies;server;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Base.Dependencies/HPD.Base.Dependencies.csproj" />
    <ProjectReference Include="../HPD.Base.LiveQuery.Abstractions/HPD.Base.LiveQuery.Abstractions.csproj" />
    <ProjectReference Include="../HPD.Base.Runtime/HPD.Base.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>
</Project>
