<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Base.Realtime</RootNamespace>
    <AssemblyName>HPD.Base.Realtime.Abstractions</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Base.Realtime.Abstractions</PackageId>
    <Description>Stable DTOs and protocol contracts for HPD.BASE realtime event feeds.</Description>
    <PackageTags>hpd;base;realtime;events;websocket;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD.Base.Abstractions/HPD.Base.Abstractions.csproj" />
  </ItemGroup>
</Project>
