<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Base.Application</RootNamespace>
    <AssemblyName>HPD.Base.Application</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Base.Application</PackageId>
    <Description>Typed, AOT-safe application contracts for HPD.BASE collections, fields, sessions, queries, and mutations.</Description>
    <PackageTags>hpd;base;application;typed;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD.Base/HPD.Base.csproj" />
    <ProjectReference Include="../HPD.Base.InMemory/HPD.Base.InMemory.csproj" />
    <ProjectReference Include="../HPD.Base.Sqlite/HPD.Base.Sqlite.csproj" />
    <ProjectReference Include="../HPD.Base.Files.InMemory/HPD.Base.Files.InMemory.csproj" />
    <ProjectReference Include="../HPD.Base.AspNetCore/HPD.Base.AspNetCore.csproj" />
    <ProjectReference Include="../HPD.Base.Application.Generators/HPD.Base.Application.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../HPD.Base.Application.Generators/bin/$(Configuration)/netstandard2.0/HPD.Base.Application.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false"
          Condition="Exists('../HPD.Base.Application.Generators/bin/$(Configuration)/netstandard2.0/HPD.Base.Application.Generators.dll')" />
  </ItemGroup>
</Project>
