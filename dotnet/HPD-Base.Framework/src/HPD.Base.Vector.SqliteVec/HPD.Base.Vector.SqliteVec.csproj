<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Base.Vector.SqliteVec</RootNamespace>
    <AssemblyName>HPD.Base.Vector.SqliteVec</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Base.Vector.SqliteVec</PackageId>
    <Description>Exact co-located sqlite-vec provider for HPD Base vector execution.</Description>
    <PackageTags>hpd;base;vector;sqlite;sqlite-vec;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Base.Vector/HPD.Base.Vector.csproj" />
    <ProjectReference Include="../HPD.Base.Sqlite/HPD.Base.Sqlite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
  </ItemGroup>
</Project>
