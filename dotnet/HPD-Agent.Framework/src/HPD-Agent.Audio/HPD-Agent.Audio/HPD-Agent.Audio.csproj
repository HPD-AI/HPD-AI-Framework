<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.Audio</RootNamespace>
    <AssemblyName>HPD.Agent.Audio</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Audio</PackageId>
    <Description>Audio runtime contracts, deterministic runtime, and HPD Agent integration for HPD Agent audio.</Description>
    <PackageTags>ai;agent;audio;realtime;middleware</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);1591;CS8604;HPDA005</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);HPDAEVT001</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD.Agent.Audio.V2.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.LiveAudio.Contracts.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Audio.VoiceActivity.CompositionExample" />
    <InternalsVisibleTo Include="HPD.Agent.Providers.Audio.ElevenLabs" />
    <InternalsVisibleTo Include="HPD.Agent.Providers.Audio.OpenAI" />
    <InternalsVisibleTo Include="HPD-Agent.Audio.LiveKit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.10" />
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../shared/src/HPD-RealtimeMedia/src/HPD-Audio.Primitives/HPD-Audio.Primitives.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <PackageReference Include="HPD-Audio.Primitives" Version="$(HPDRealtimeMediaVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
  </ItemGroup>

</Project>
