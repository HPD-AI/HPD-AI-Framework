<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.Providers.Audio.ElevenLabs</RootNamespace>
    <AssemblyName>HPD.Agent.Providers.Audio.ElevenLabs</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Providers.Audio.ElevenLabs</PackageId>
    <Description>ElevenLabs audio provider adapters for HPD Agent audio.</Description>
    <PackageTags>ai;agent;audio;elevenlabs;stt;tts</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);1591;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <ProjectReference Include="../../HPD-Agent.Audio/HPD-Agent.Audio/HPD-Agent.Audio.csproj" />
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD.Agent.Audio.V2.Tests" />
  </ItemGroup>

</Project>
