<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.Providers.Audio.Silero</RootNamespace>
    <AssemblyName>HPD.Agent.Providers.Audio.Silero</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Providers.Audio.Silero</PackageId>
    <Description>Silero voice activity detection provider adapter for HPD Agent audio.</Description>
    <PackageTags>ai;agent;audio;silero;vad</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.0" />
    <ProjectReference Include="../../HPD-Agent.Audio/HPD-Agent.Audio.csproj" />
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <InternalsVisibleTo Include="HPD.Agent.Audio.V2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
