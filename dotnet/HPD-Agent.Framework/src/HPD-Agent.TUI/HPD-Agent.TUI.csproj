<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.TUI</RootNamespace>
    <AssemblyName>HPD-Agent.TUI</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.TUI</PackageId>
    <Description>Terminal UI shell primitives for HPD agents.</Description>
    <PackageTags>ai;agent;tui;terminal;hpd</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../HPD-TUI.Framework/src/HPD-TUI.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <PackageReference Include="HPD-TUI" Version="$(HPDTuiVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
  </ItemGroup>

</Project>
