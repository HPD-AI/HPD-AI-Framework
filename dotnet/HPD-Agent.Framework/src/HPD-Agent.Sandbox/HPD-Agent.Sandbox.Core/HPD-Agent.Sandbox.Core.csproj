<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HpdAgentEventPrecompileRequireAnalyzer>false</HpdAgentEventPrecompileRequireAnalyzer>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Agent.Sandbox</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Sandbox.Core</PackageId>
    <Description>Shared sandbox policy, contracts, state, network mediation, and OS-family enforcement for HPD Agent.</Description>
    <PackageTags>sandbox;policy;process-isolation;security;network;bwrap;bubblewrap;sandbox-exec;seatbelt;seccomp;bpf</PackageTags>
    <BuildSeccompHelpers Condition="'$(BuildSeccompHelpers)' == ''">true</BuildSeccompHelpers>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddSeccompHelpersToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../../../shared/src/HPD-Events/HPD-Events.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />

    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="HPD-Events" Version="$(HPDEventsVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent.Sandbox.Core.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Sandbox.Local.Tests" />
  </ItemGroup>

  <Target Name="BuildSeccompHelpersForLinux"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(BuildSeccompHelpers)' == 'true'">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/build.sh&quot;" />
  </Target>

  <Target Name="AddSeccompHelpersToPackage"
          DependsOnTargets="BuildSeccompHelpersForLinux"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(BuildSeccompHelpers)' == 'true'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-x64"
                              Condition="Exists('$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-x64')">
        <PackagePath>runtimes/linux-x64/native/apply-seccomp-x64</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-arm64"
                              Condition="Exists('$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-arm64')">
        <PackagePath>runtimes/linux-arm64/native/apply-seccomp-arm64</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Platforms/Linux/Seccomp/native/*.c">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/native-src</PackagePath>
    </Content>
    <Content Include="Platforms/Linux/Seccomp/native/build.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/native-src</PackagePath>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup><WarningsAsErrors>$(WarningsAsErrors)</WarningsAsErrors></PropertyGroup>
</Project>
