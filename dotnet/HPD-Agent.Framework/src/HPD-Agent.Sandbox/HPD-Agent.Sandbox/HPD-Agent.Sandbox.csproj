<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HpdAgentEventPrecompileRequireAnalyzer>false</HpdAgentEventPrecompileRequireAnalyzer>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Agent.Sandbox</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Sandbox</PackageId>
    <Description>Backend-neutral Agent sandbox composition, capability admission, and logical workspace bindings.</Description>
    <PackageTags>sandbox;contracts;composition;capabilities;workspace;agent;environment</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../../../shared/src/HPD-Events/HPD-Events.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <ProjectReference Include="../../../../HPD-Environment.Framework/src/HPD-Environment.Contracts/HPD-Environment.Contracts.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <ProjectReference Include="../../../../HPD-Environment.Framework/src/HPD-Environment.Runtime/HPD-Environment.Runtime.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />

    <PackageReference Include="HPD-Events" Version="$(HPDEventsVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
    <PackageReference Include="HPD-Environment.Contracts" Version="$(HPDEnvironmentVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
    <PackageReference Include="HPD-Environment.Runtime" Version="$(HPDEnvironmentVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent.Sandbox.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
