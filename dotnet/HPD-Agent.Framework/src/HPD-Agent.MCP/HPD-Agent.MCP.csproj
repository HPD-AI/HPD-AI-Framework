<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.MCP</PackageId>
    <!-- Inherits TargetFrameworks from Directory.Build.props: net10.0;net9.0;net8.0 -->
    <RootNamespace>HPD.Agent.MCP</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Native AOT Configuration -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <OutputType>Library</OutputType>
    <Description>Model Context Protocol client integration for HPD-Agent, with Streamable HTTP and stdio transports, tool/resource/prompt projection, OAuth, permissions, and bounded remote tasks.</Description>
    <PackageTags>hpd;agent;mcp;model-context-protocol;tools</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent" />
    <InternalsVisibleTo Include="HPD-Agent.FFI" />
    <InternalsVisibleTo Include="HPD-Agent.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.MCP.AotSmoke" />
    <InternalsVisibleTo Include="AgentConsoleTest" />
    <InternalsVisibleTo Include="AgentAPI" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core AI Framework -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />

    <!-- MCP Support -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Tasks" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Agent/HPD-Agent.csproj" />
  </ItemGroup>

</Project>
