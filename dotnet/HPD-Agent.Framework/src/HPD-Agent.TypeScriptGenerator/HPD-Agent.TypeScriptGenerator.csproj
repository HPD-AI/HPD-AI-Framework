<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained;RuntimeIdentifier">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../../typescript/hpd-agent-client/src/*.ts"
                      LogicalName="SdkSource.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../typescript/hpd-agent-client/test/client.test.mjs"
                      LogicalName="SdkSource.client.test.mjs" />
    <EmbeddedResource Include="../../../../typescript/hpd-agent-client/test/types.ts"
                      LogicalName="SdkSource.types.ts" />
    <EmbeddedResource Include="../../../../typescript/hpd-agent-client/test/tsconfig.json"
                      LogicalName="SdkSource.tsconfig.json" />
    <ProjectReference Include="../HPD-Agent.SDK.Contract/HPD-Agent.SDK.Contract.csproj" />
  </ItemGroup>
</Project>
