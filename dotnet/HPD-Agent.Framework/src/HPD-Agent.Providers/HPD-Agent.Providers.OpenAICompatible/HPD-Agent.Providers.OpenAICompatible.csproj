<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <PackageId>HPD-Agent.Providers.OpenAICompatible</PackageId>
    <Title>HPD-Agent OpenAI-Compatible Provider Base</Title>
    <Description>Reusable OpenAI-compatible chat completions infrastructure for HPD-Agent providers</Description>
    <PackageTags>ai;agent;openai-compatible;llm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/HPD-Agent/HPD-Agent.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent.Providers.Tests" />
  </ItemGroup>
</Project>
