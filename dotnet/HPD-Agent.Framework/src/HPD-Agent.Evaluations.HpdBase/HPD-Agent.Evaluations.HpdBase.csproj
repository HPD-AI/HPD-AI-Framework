<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Agent.Evaluations.HpdBase</RootNamespace>
    <AssemblyName>HPD-Agent.Evaluations.HpdBase</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Evaluations.HpdBase</PackageId>
    <Description>HPD Base-backed durable score, run, dataset, and evaluation result storage for HPD Agent.</Description>
    <PackageTags>ai;agent;evaluation;storage;persistence;hpd-base;sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Agent.Evaluations/HPD-Agent.Evaluations.csproj" />
    <ProjectReference Include="../../../HPD-Base.Framework/src/HPD.Base/HPD.Base.csproj"
                      Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <ProjectReference Include="../../../HPD-Base.Framework/src/HPD.Base.Generators/HPD.Base.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedHpdDependencies)' == 'true'">
    <PackageReference Include="HPD.Base" Version="$(HPDBaseVersion)" />
  </ItemGroup>

</Project>
