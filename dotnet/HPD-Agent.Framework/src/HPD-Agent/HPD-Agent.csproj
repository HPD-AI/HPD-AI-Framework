<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <HpdAgentEventPrecompileRequireAnalyzer>false</HpdAgentEventPrecompileRequireAnalyzer>
    <!-- Inherits TargetFrameworks from Directory.Build.props: net10.0;net9.0;net8.0 -->
    <RootNamespace>HPD.Agent</RootNamespace>
    <HpdAgentEventModuleId>hpd.agent.core</HpdAgentEventModuleId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);HPDAUDIO001;MEAI001;IL2026;IL2075;IL3050;CS0108;CS0628;CS8424;CS8600;CS8601;CS8602;CS8604;CS8619;CS8907;CS9113</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors)</WarningsAsErrors>
    <!-- Native AOT Configuration -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <!-- Enable packaging for this project -->
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Framework</PackageId>
    <Description>A middleware-driven agentic AI framework built on Microsoft.Extensions.AI for building intelligent, tool-using agents.</Description>
    <PackageTags>ai;agent;llm;middleware;microsoft-extensions-ai;agentic;framework</PackageTags>
    <!-- Version, Authors, Company, Copyright, License, etc. are inherited from Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Core AI Framework (Protocol-Agnostic) -->
    <!-- Microsoft.Agents.AI.Abstractions removed - core is now protocol-agnostic -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
    <PackageReference Include="System.Formats.Cbor" Version="10.0.10" />
    <PackageReference Include="NLayer" Version="1.16.0" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier" AdditionalProperties="PublishAot=false;SelfContained=false;RuntimeIdentifier=" />
    <ProjectReference Include="../../../HPD-Environment.Framework/src/HPD-Environment.Abstractions/HPD-Environment.Abstractions.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <ProjectReference Include="../../../HPD-Environment.Framework/src/HPD-Environment.Runtime/HPD-Environment.Runtime.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <ProjectReference Include="../../../shared/src/HPD-Events/HPD-Events.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <ProjectReference Include="../../../shared/src/HPD-Serialization/HPD-Serialization.csproj" Condition="'$(UsePublishedHpdDependencies)' != 'true'" />
    <PackageReference Include="HPD-Environment.Abstractions" Version="$(HPDEnvironmentVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
    <PackageReference Include="HPD-Environment.Runtime" Version="$(HPDEnvironmentVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
    <PackageReference Include="HPD-Events" Version="$(HPDEventsVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
    <PackageReference Include="HPD-Serialization" Version="$(HPDSerializationVersion)" Condition="'$(UsePublishedHpdDependencies)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Authority/Generated/authority-id-families-v1.txt" />
    <AdditionalFiles Include="Authority/Generated/authority-schema-ledger-v1.txt" />
    <AdditionalFiles Include="Authority/Generated/authority-capacity-dimensions-v1.txt" />
    <AdditionalFiles Include="Authority/Generated/authority-capacity-governance-v1.txt" />
  </ItemGroup>

  <!-- Pack source generator as analyzer in NuGet package -->
  <Target Name="IncludeAnalyzers" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="../HPD-Agent.SourceGenerator/bin/$(Configuration)/netstandard2.0/HPD-Agent.SourceGenerator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <!-- Include dependencies of the source generator -->
      <None Include="../HPD-Agent.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('../HPD-Agent.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.dll')" />
      <None Include="../HPD-Agent.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('../HPD-Agent.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll')" />
      <None Include="buildTransitive/HPD-Agent.Framework.targets" Pack="true" PackagePath="buildTransitive/HPD-Agent.Framework.targets" Visible="false" />
      <None Include="../HPD-Agent.EventPrecompiler/bin/Debug/net8.0/*.dll;../HPD-Agent.EventPrecompiler/bin/Debug/net8.0/*.json"
            Pack="true" PackagePath="tools/net8.0/" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Expose internals to test projects -->
  <ItemGroup>
    <InternalsVisibleTo Include="HPD.Agent.Audio" />
    <InternalsVisibleTo Include="HPD-Agent.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.ToolHarness.Runtime.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Authority.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.LiveAudio.Contracts.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Hosting.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Evaluations.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Harness.Coding.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.AIFunctionContracts.AotSmoke" />
    <InternalsVisibleTo Include="HPD-Agent.Audio.VoiceActivity.AotSmoke" />
    <InternalsVisibleTo Include="HPD-Agent.Audio.VoiceActivity.CompositionExample" />
  </ItemGroup>

</Project>
