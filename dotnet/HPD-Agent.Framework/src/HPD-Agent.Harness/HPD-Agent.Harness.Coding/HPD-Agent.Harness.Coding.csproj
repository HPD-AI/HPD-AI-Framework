<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <!-- Inherits TargetFrameworks from Directory.Build.props: net10.0;net9.0;net8.0 -->
    <RootNamespace>HPD.Agent.ToolHarness.Coding</RootNamespace>

    <!-- Native AOT Configuration -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <NoWarn>$(NoWarn);CA2255;CS8602;CS8620;IL2026;IL3050</NoWarn>

    <!-- Package Metadata (inherits Version, Authors, License from Directory.Build.props) -->
    <PackageId>HPD-Agent.ToolHarness.Coding</PackageId>
    <Description>Coding toolharness for HPD-Agent. Provides AI functions for codebase inspection, symbol search, and implementation planning.</Description>
    <PackageTags>ai;agent;coding;codebase;toolharness;hpd-agent</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.9" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Markdig" Version="1.2.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.7" />
    <PackageReference Include="Ude.NetStandard" Version="1.2.0" />

    <!-- JSON Schema -->
    <PackageReference Include="JsonSchema.Net.Generation" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to core HPD-Agent project -->
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../HPD-Agent.Harness.Coding.SourceGenerator/HPD-Agent.Harness.Coding.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier" AdditionalProperties="PublishAot=false;SelfContained=false;RuntimeIdentifier=" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Ripgrep/pack/**/*.cs" />
    <None Remove="Ripgrep/pack/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent.Harness.Coding.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Harness.Coding.TUI.Tests" />
  </ItemGroup>

  <!-- Pack coding source generator as analyzer in the Coding NuGet package. -->
  <Target Name="IncludeCodingAnalyzers" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <CodingSourceGeneratorAssembly>$(MSBuildProjectDirectory)/../HPD-Agent.Harness.Coding.SourceGenerator/bin/$(Configuration)/netstandard2.0/HPD-Agent.Harness.Coding.SourceGenerator.dll</CodingSourceGeneratorAssembly>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(CodingSourceGeneratorAssembly)')"
      Text="Coding source generator was not built. Expected '$(CodingSourceGeneratorAssembly)' before packing HPD-Agent.ToolHarness.Coding." />
    <ItemGroup>
      <None Include="$(CodingSourceGeneratorAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="../HPD-Agent.Harness.Coding.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('../HPD-Agent.Harness.Coding.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.dll')" />
      <None Include="../HPD-Agent.Harness.Coding.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('../HPD-Agent.Harness.Coding.SourceGenerator/bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll')" />
    </ItemGroup>
  </Target>

  <!-- Bundle coding TUI assemblies into this package instead of publishing a separate coding TUI package. -->
  <Target Name="IncludeBundledCodingTui" BeforeTargets="_GetPackageFiles" Condition="'$(TargetFramework)' != ''">
    <ItemGroup>
      <None Include="../HPD-Agent.Harness.Coding.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.Harness.Coding.TUI.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" Condition="Exists('../HPD-Agent.Harness.Coding.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.Harness.Coding.TUI.dll')" />
      <None Include="../HPD-Agent.Harness.Coding.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.Harness.Coding.TUI.xml" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" Condition="Exists('../HPD-Agent.Harness.Coding.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.Harness.Coding.TUI.xml')" />
      <None Include="../../HPD-Agent.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.TUI.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" Condition="Exists('../../HPD-Agent.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.TUI.dll')" />
      <None Include="../../HPD-Agent.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.TUI.xml" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" Condition="Exists('../../HPD-Agent.TUI/bin/$(Configuration)/$(TargetFramework)/HPD-Agent.TUI.xml')" />
      <None Include="../../../../HPD-TUI.Framework/src/bin/$(Configuration)/$(TargetFramework)/HPD.TUI.dll" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" Condition="Exists('../../../../HPD-TUI.Framework/src/bin/$(Configuration)/$(TargetFramework)/HPD.TUI.dll')" />
      <None Include="../../../../HPD-TUI.Framework/src/bin/$(Configuration)/$(TargetFramework)/HPD.TUI.xml" Pack="true" PackagePath="lib/$(TargetFramework)/" Visible="false" Condition="Exists('../../../../HPD-TUI.Framework/src/bin/$(Configuration)/$(TargetFramework)/HPD.TUI.xml')" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <RipgrepPackRoot>$(MSBuildProjectDirectory)/obj/RipgrepPack/</RipgrepPackRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(RipgrepPackRoot)Generated/**/*.cs" Visible="false" Condition="Exists('$(RipgrepPackRoot)Generated')" />
    <None Include="$(RipgrepPackRoot)runtimes/**/native/*" Pack="true" PackagePath="runtimes/" Visible="false" Condition="Exists('$(RipgrepPackRoot)runtimes')" />
  </ItemGroup>

  <Target Name="CopyRipgrepRuntimeAssets" AfterTargets="Build" Condition="Exists('$(RipgrepPackRoot)runtimes')">
    <ItemGroup>
      <RipgrepRuntimeAsset Include="$(RipgrepPackRoot)runtimes/**/native/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RipgrepRuntimeAsset)"
      DestinationFiles="@(RipgrepRuntimeAsset->'$(OutputPath)runtimes/%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
