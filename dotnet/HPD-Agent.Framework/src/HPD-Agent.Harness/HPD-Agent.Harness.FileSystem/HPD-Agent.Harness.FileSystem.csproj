<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <HpdAgentEventPrecompileRequireAnalyzer>false</HpdAgentEventPrecompileRequireAnalyzer>
    <IsPackable>true</IsPackable>
    <!-- Inherits TargetFrameworks from Directory.Build.props: net10.0;net9.0;net8.0 -->
    <RootNamespace>HPD.Agent.ToolHarness.FileSystem</RootNamespace>

    <!-- Native AOT Configuration -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The public types are intentionally obsolete; internal compatibility references
         are part of the deprecation window. Consumers still receive CS0618. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>

    <!-- Package Metadata (inherits Version, Authors, License from Directory.Build.props) -->
    <PackageId>HPD-Agent.ToolHarness.FileSystem</PackageId>
    <Description>[DEPRECATED] This package is retained only for migration. It does not provide a supported security boundary. Use HPD-Agent.ToolHarness.Coding for workspace tools or sandboxed execution for untrusted workloads.</Description>
    <PackageTags>ai;agent;filesystem;toolharness;hpd-agent;deprecated</PackageTags>
    <PackageReleaseNotes>Deprecated in HPD-Agent 1.0.0. This harness is not a supported workspace-isolation or command-execution security boundary. Use HPD-Agent.ToolHarness.Coding for trusted coding workspaces or a sandbox runtime for untrusted execution. See README.md and DEPRECATION.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core dependencies (match HPD-Agent versions) -->
    <PackageReference Include="CliWrap" Version="3.10.5" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />

    <!-- File operations -->
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="MAB.DotIgnore" Version="3.0.2" />
    <PackageReference Include="Ude.NetStandard" Version="1.2.0" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />

    <!-- JSON Schema (match HPD-Agent) -->
    <PackageReference Include="JsonSchema.Net.Generation" Version="7.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to core HPD-Agent project -->
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="DEPRECATION.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
