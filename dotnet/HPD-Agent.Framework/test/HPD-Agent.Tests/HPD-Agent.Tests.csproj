<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Agent.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="FluentAssertions" Version="$(FluentAssertionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude V1 archived test files from compilation -->
    <Compile Remove="**/*.V1.OLD.cs" />
    <!-- Authority kernels run in the dependency-minimal authority test project. -->
    <Compile Remove="Authority/**/*.cs" />
    <Compile Include="Authority/SessionLifecycleAuthorityArchitectureV1Tests.cs" />
    <!-- Provider catalog and generator tests run without the broad provider/Audio graph. -->
    <Compile Remove="Core/ProviderManifestContractsTests.cs" />
    <Compile Remove="SourceGenerator/ProviderManifestSourceGeneratorTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content/Fixtures/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HPD-Agent.Audio/HPD-Agent.Audio/HPD-Agent.Audio.csproj" />
    <ProjectReference Include="../../src/HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.FFI/HPD-Agent.FFI.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="true" />
    <ProjectReference Include="../../src/HPD-Agent.Harness/HPD-Agent.Harness.FileSystem/HPD-Agent.Harness.FileSystem.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.Harness/HPD-Agent.Harness.WebSearch/HPD-Agent.Harness.WebSearch.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.MultiAgent/HPD-Agent.MultiAgent.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.MCP/HPD-Agent.MCP.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.MCP.Tasks/HPD-Agent.MCP.Tasks.csproj" />
    <ProjectReference Include="../../../shared/src/HPD-Serialization/HPD-Serialization.csproj" />
  </ItemGroup>

</Project>
