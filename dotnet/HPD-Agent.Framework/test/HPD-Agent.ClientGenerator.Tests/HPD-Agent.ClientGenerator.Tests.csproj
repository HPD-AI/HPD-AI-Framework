<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HPD-Agent.ClientGenerator/HPD-Agent.ClientGenerator.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.GoGenerator/HPD-Agent.GoGenerator.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.PythonGenerator/HPD-Agent.PythonGenerator.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.TypeScriptGenerator/HPD-Agent.TypeScriptGenerator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../sdk/conformance/fixtures/*.json"
             Link="Conformance/fixtures/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
