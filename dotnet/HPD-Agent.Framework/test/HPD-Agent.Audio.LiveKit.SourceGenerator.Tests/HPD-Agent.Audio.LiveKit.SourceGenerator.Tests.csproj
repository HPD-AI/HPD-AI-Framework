<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The generator is netstandard2.0/compiler-version driven; one host TFM avoids
         loading its .NET 10 Roslyn dependencies into net8/net9 test processes. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Agent.Audio.LiveKit.SourceGenerator.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HPD-Agent.Audio/HPD-Agent.Audio.LiveKit/HPD-Agent.Audio.LiveKit.SourceGenerator/HPD-Agent.Audio.LiveKit.SourceGenerator.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.Audio/HPD-Agent.Audio.LiveKit/HPD-Agent.Audio.LiveKit/HPD-Agent.Audio.LiveKit.csproj" />
  </ItemGroup>
</Project>
