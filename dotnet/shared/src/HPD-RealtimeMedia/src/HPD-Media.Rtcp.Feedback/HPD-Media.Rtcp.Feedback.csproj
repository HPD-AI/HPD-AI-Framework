<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Media.Rtcp.Feedback</RootNamespace>
    <AssemblyName>HPD.Media.Rtcp.Feedback</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Media.Rtcp.Feedback</PackageId>
    <Description>RTCP feedback packet contracts and low-allocation parse/write surfaces for HPD realtime media infrastructure.</Description>
    <PackageTags>hpd;media;rtcp;feedback;realtime-media</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD-Media.Rtcp\HPD-Media.Rtcp.csproj" />
    <ProjectReference Include="..\HPD-Media.Rtp\HPD-Media.Rtp.csproj" />
  </ItemGroup>

</Project>
