<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Media.WebRTC</RootNamespace>
    <AssemblyName>HPD.Media.WebRTC</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Media.WebRTC</PackageId>
    <Description>WebRTC signaling, provider registration, and ICE composition contracts for HPD realtime media infrastructure.</Description>
    <PackageTags>hpd;media;webrtc;ice;realtime-media</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD-Media.Rtcp\HPD-Media.Rtcp.csproj" />
    <ProjectReference Include="..\HPD-Media.Rtp\HPD-Media.Rtp.csproj" />
    <ProjectReference Include="..\HPD-Media.Sdp\HPD-Media.Sdp.csproj" />
    <ProjectReference Include="..\HPD-Media.Transport\HPD-Media.Transport.csproj" />
  </ItemGroup>

</Project>
