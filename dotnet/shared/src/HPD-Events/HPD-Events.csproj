<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Events</RootNamespace>
    <AssemblyName>HPD.Events</AssemblyName>
    <IsPackable>true</IsPackable>

    <!-- Native AOT Configuration -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <NoWarn>$([System.String]::Copy('$(NoWarn)').Replace(';CS1591', ''))</NoWarn>

    <!-- Package metadata -->
    <PackageId>HPD-Events</PackageId>
    <Description>Universal event coordination system for the HPD ecosystem. Provides channel-based event streaming, hierarchical event bubbling, and cross-domain event composition.</Description>
    <PackageTags>events;event-coordination;streaming;event-channels;event-bubbling</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent" />
  </ItemGroup>

</Project>
