<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Environment.Runtime</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Environment.Runtime</PackageId>
    <Description>Provider registry, planning, and in-memory runtime helpers for HPD execution environments.</Description>
    <PackageTags>execution;environment;runtime;providers;planner;hpd</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.13" />
    <ProjectReference Include="../HPD-Environment.Contracts/HPD-Environment.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Environment.Virtualization.Apple" />
    <InternalsVisibleTo Include="HPD-Environment.HostContainers" />
    <InternalsVisibleTo Include="HPD-Environment.HostProcess" />
    <InternalsVisibleTo Include="HPD-Environment.Runtime.Tests" />
    <InternalsVisibleTo Include="HPD-Environment.Virtualization.Apple.Tests" />
  </ItemGroup>
</Project>
