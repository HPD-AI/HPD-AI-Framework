<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Environment.Virtualization.Apple</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Environment.Virtualization.Apple</PackageId>
    <Description>Apple Virtualization.framework environment provider for HPD Agent using a supervised hpd-vz helper.</Description>
    <PackageTags>execution;apple;virtualization;macos;vm;microvm;hpd-vz</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../HPD-Environment.Contracts/HPD-Environment.Contracts.csproj" />
    <ProjectReference Include="../../HPD-Environment.Runtime/HPD-Environment.Runtime.csproj" />
    <ProjectReference Include="../HPD-Environment.Virtualization.Contracts/HPD-Environment.Virtualization.Contracts.csproj" />
    <ProjectReference Include="../HPD-Environment.Virtualization.GuestAgent/HPD-Environment.Virtualization.GuestAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Environment.Virtualization.Apple.Tests" />
  </ItemGroup>
</Project>
