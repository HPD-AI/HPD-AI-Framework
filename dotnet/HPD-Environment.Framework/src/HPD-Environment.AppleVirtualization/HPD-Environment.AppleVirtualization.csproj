<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Environment.AppleVirtualization</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Environment.AppleVirtualization</PackageId>
    <Description>Apple Virtualization.framework environment provider for HPD Agent using a supervised hpd-vz helper.</Description>
    <PackageTags>execution;apple;virtualization;macos;vm;microvm;hpd-vz</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Environment.Abstractions/HPD-Environment.Abstractions.csproj" />
    <ProjectReference Include="../HPD-Environment.Runtime/HPD-Environment.Runtime.csproj" />
    <ProjectReference Include="../../../HPD-Agent.Framework/src/HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../../HPD-Agent.Framework/src/HPD-Agent.Sandbox/HPD-Agent.Sandbox.Core/HPD-Agent.Sandbox.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Environment.AppleVirtualization.Tests" />
  </ItemGroup>
</Project>
