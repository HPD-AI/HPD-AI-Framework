<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>HPD.Extract</RootNamespace>
    <AssemblyName>HPD.Extract.Images</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <OutputType>Library</OutputType>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>HPD-Extract.Images</PackageId>
    <Description>Image OCR decoder integration for HPD Extract.</Description>
    <PackageTags>extract;image;ocr;jpeg;png;tiff</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Extract.Abstractions/HPD-Extract.Abstractions.csproj" />
  </ItemGroup>

</Project>
