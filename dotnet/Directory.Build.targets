<Project>
  <PropertyGroup>
    <IsHpdAgentFrameworkProject Condition="'$(IsHpdAgentFrameworkProject)' == ''">$([System.String]::Copy('$(MSBuildProjectFullPath)').StartsWith('$(MSBuildThisFileDirectory)HPD-Agent.Framework'))</IsHpdAgentFrameworkProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != '' AND '$(TargetFrameworks)' == '$(TargetFrameworksModern)'">
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <ItemGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('HPD-Agent.Providers.'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.SourceGenerator/HPD-Agent.SourceGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier"
                      AdditionalProperties="PublishAot=false;SelfContained=false;RuntimeIdentifier=" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != '' AND '$(EnableLegacySupport)' == 'true' AND '$(TargetFrameworks)' == '$(TargetFrameworksModern);$(TargetFrameworksLegacy)'">
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsHpdAgentFrameworkProject)' == 'true' And '$(MSBuildProjectName)' != 'HPD-Agent.EventPrecompiler' And Exists('$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent/buildTransitive/HPD-Agent.Framework.targets')">
    <HpdAgentEventPrecompilerPath>$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.EventPrecompiler/bin/Debug/net8.0/HPD-Agent.EventPrecompiler.dll</HpdAgentEventPrecompilerPath>
    <HpdAgentEventPrecompileDependsOn>HpdBuildEventPrecompiler</HpdAgentEventPrecompileDependsOn>
    <HpdAgentEventPrecompileRequireAnalyzer Condition="'$(HpdAgentEventPrecompileRequireAnalyzer)' == ''">true</HpdAgentEventPrecompileRequireAnalyzer>
  </PropertyGroup>

  <Target Name="HpdBuildEventPrecompiler"
          Condition="'$(IsHpdAgentFrameworkProject)' == 'true' And '$(MSBuildProjectName)' != 'HPD-Agent.EventPrecompiler' And Exists('$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.EventPrecompiler/HPD-Agent.EventPrecompiler.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.EventPrecompiler/HPD-Agent.EventPrecompiler.csproj"
             Targets="Build"
             BuildInParallel="false"
             Properties="Configuration=Debug;TargetFramework=net8.0;PublishAot=false;SelfContained=false;RuntimeIdentifier=" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent/buildTransitive/HPD-Agent.Framework.targets"
          Condition="'$(IsHpdAgentFrameworkProject)' == 'true' And '$(MSBuildProjectName)' != 'HPD-Agent.EventPrecompiler' And Exists('$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent/buildTransitive/HPD-Agent.Framework.targets')" />
</Project>
