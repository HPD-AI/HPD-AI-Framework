<Project>
  <PropertyGroup Condition="'$(TargetFramework)' != '' AND '$(TargetFrameworks)' == '$(TargetFrameworksModern)'">
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' != '' AND '$(EnableLegacySupport)' == 'true' AND '$(TargetFrameworks)' == '$(TargetFrameworksModern);$(TargetFrameworksLegacy)'">
    <TargetFrameworks></TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'HPD-Agent.EventPrecompiler' And Exists('$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent/buildTransitive/HPD-Agent.Framework.targets')">
    <HpdAgentEventPrecompilerPath>$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.EventPrecompiler/bin/Debug/net8.0/HPD-Agent.EventPrecompiler.dll</HpdAgentEventPrecompilerPath>
    <HpdAgentEventPrecompileDependsOn>HpdBuildEventPrecompiler</HpdAgentEventPrecompileDependsOn>
    <HpdAgentEventPrecompileRequireAnalyzer Condition="'$(HpdAgentEventPrecompileRequireAnalyzer)' == ''">true</HpdAgentEventPrecompileRequireAnalyzer>
  </PropertyGroup>

  <Target Name="HpdBuildEventPrecompiler"
          Condition="'$(MSBuildProjectName)' != 'HPD-Agent.EventPrecompiler' And Exists('$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.EventPrecompiler/HPD-Agent.EventPrecompiler.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent.EventPrecompiler/HPD-Agent.EventPrecompiler.csproj"
             Targets="Restore;Build"
             BuildInParallel="false"
             Properties="Configuration=Debug;TargetFramework=net8.0;PublishAot=false;SelfContained=false;RuntimeIdentifier=" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent/buildTransitive/HPD-Agent.Framework.targets"
          Condition="'$(MSBuildProjectName)' != 'HPD-Agent.EventPrecompiler' And Exists('$(MSBuildThisFileDirectory)HPD-Agent.Framework/src/HPD-Agent/buildTransitive/HPD-Agent.Framework.targets')" />
</Project>
