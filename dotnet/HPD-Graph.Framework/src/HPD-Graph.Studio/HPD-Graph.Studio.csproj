<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <RootNamespace>HPD.Graph.Studio</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Graph.Studio</PackageId>
    <Description>HPD Graph Studio module package for HPD AI Platform.</Description>
    <PackageTags>ai;graph;workflow;studio;svelte</PackageTags>
    <StudioGraphModuleRoot>$(MSBuildThisFileDirectory)..\..\..\..\typescript\hpd-ai-studio\modules\hpd-graph-studio\</StudioGraphModuleRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HPD-AI.Platform\HPD-AI.Platform.csproj" />
    <ProjectReference Include="..\..\..\HPD-Base.Framework\src\HPD.Base\HPD.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(StudioGraphModuleRoot)**\*" Exclude="$(StudioGraphModuleRoot)node_modules\**\*;$(StudioGraphModuleRoot)dist\**\*" Pack="true" PackagePath="clientapp-modules\hpd-graph-studio\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(StudioGraphModuleRoot)dist\graph.js" LogicalName="HPD.Graph.Studio.Assets.graph.js" />
    <None Include="$(StudioGraphModuleRoot)dist\graph.js" Pack="true" PackagePath="studio-assets\graph\ad53192c6b4e30b967b69c210a14edef1bd80422f4ac5b0356ba808713e8a44a.js" />
  </ItemGroup>

</Project>
