<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Auth-ControlPlane-AspNetCore</PackageId>
    <Description>ASP.NET Core control-plane security composition for HPD frameworks.</Description>
    <PackageTags>auth;authorization;control-plane;aspnetcore;hpd</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <ProjectReference Include="../HPD.Auth.Core/HPD.Auth.Core.csproj" />
  </ItemGroup>
</Project>
