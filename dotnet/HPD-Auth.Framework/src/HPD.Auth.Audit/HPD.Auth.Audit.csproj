<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Auth-Audit</PackageId>
    <Description>Audit logging and event integration for HPD-Auth identity workflows.</Description>
    <PackageTags>auth;audit;events;identity;hpd</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Auth.Core/HPD.Auth.Core.csproj" />
    <ProjectReference Include="../HPD.Auth.Infrastructure/HPD.Auth.Infrastructure.csproj" />
    <ProjectReference Include="../HPD.Auth/HPD.Auth.csproj" />
    <ProjectReference Include="../../../shared/src/HPD-Events/HPD-Events.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
  </ItemGroup>
</Project>
