<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Auth-Authorization</PackageId>
    <Description>Authorization policies, requirements, handlers, and middleware for HPD-Auth.</Description>
    <PackageTags>auth;authorization;policies;aspnetcore;hpd</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Auth.Core/HPD.Auth.Core.csproj" />
    <ProjectReference Include="../HPD.Auth/HPD.Auth.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
