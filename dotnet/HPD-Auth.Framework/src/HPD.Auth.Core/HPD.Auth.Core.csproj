<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HPD.Auth.Core</RootNamespace>
    <AssemblyName>HPD.Auth.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Auth-Core</PackageId>
    <Description>Core entities, options, contracts, and services for HPD-Auth.</Description>
    <PackageTags>auth;identity;contracts;aspnetcore;hpd</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../shared/src/HPD-Events/HPD-Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
  </ItemGroup>

</Project>
