<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HPD.Auth.Infrastructure</RootNamespace>
    <AssemblyName>HPD.Auth.Infrastructure</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Auth-Infrastructure</PackageId>
    <Description>HPD Base-backed identity, credential, session, audit, and data-protection infrastructure for HPD-Auth.</Description>
    <PackageTags>auth;identity;base;infrastructure;aot;hpd</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../HPD.Auth.Core/HPD.Auth.Core.csproj" />
    <ProjectReference Include="../HPD.Auth.Base/HPD.Auth.Base.csproj" />
    <ProjectReference Include="../../../HPD-Base.Framework/src/HPD.Base/HPD.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HPD.Auth.Infrastructure.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
