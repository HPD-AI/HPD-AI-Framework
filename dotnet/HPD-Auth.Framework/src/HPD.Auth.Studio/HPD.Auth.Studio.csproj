<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>HPD.Auth.Studio</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD.Auth.Studio</PackageId>
    <Description>HPD Auth Studio module package for HPD AI Platform.</Description>
    <PackageTags>auth;identity;access-control;studio;svelte</PackageTags>
    <StudioAuthModuleRoot>$(MSBuildThisFileDirectory)..\..\..\..\typescript\hpd-ai-studio\modules\hpd-auth-studio\</StudioAuthModuleRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HPD-AI.Platform\HPD-AI.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(StudioAuthModuleRoot)**\*" Exclude="$(StudioAuthModuleRoot)node_modules\**\*;$(StudioAuthModuleRoot)dist\**\*" Pack="true" PackagePath="clientapp-modules\hpd-auth-studio\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
