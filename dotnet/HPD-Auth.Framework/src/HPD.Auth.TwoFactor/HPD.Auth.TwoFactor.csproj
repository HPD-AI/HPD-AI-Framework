<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Auth-TwoFactor</PackageId>
    <Description>Two-factor authentication, TOTP, and passkey endpoint support for HPD-Auth.</Description>
    <PackageTags>auth;two-factor;totp;passkeys;hpd</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HPD.Auth.Core/HPD.Auth.Core.csproj" />
    <ProjectReference Include="../HPD.Auth/HPD.Auth.csproj" />
    <ProjectReference Include="../../../shared/src/HPD-Events/HPD-Events.csproj" />
  </ItemGroup>
</Project>
