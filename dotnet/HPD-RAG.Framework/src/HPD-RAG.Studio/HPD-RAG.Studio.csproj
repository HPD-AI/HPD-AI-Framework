<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>HPD.RAG.Studio</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-RAG.Studio</PackageId>
    <Description>HPD RAG Studio module package for HPD AI Platform.</Description>
    <PackageTags>ai;rag;retrieval;studio;svelte</PackageTags>
    <StudioRagModuleRoot>$(MSBuildThisFileDirectory)..\..\..\..\typescript\hpd-ai-studio\modules\hpd-rag-studio\</StudioRagModuleRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\HPD-AI.Platform\HPD-AI.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(StudioRagModuleRoot)**\*" Exclude="$(StudioRagModuleRoot)node_modules\**\*;$(StudioRagModuleRoot)dist\**\*" Pack="true" PackagePath="clientapp-modules\hpd-rag-studio\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
