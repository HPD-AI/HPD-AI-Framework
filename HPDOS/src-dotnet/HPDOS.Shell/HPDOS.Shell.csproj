<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-maccatalyst26.2</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <AssemblyName>hpdos-ui</AssemblyName>
    <RootNamespace>HPDOS.Shell</RootNamespace>
    <ApplicationId>com.hpd.hpdos</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationTitle>HPDOS</ApplicationTitle>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup>
    <MauiHybridWebViewSupported>true</MauiHybridWebViewSupported>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HPDOS.Core/HPDOS.Core.csproj"
                      PrivateAssets="all"
                      ExcludeAssets="frameworkReference" />
  </ItemGroup>

  <!--
    Bun build output lands in HPDOS.Core/wwwroot/.
    MauiAsset copies files to Resources/Raw/ inside the app bundle.
    LogicalName strips the source path prefix so files land at:
      Resources/Raw/wwwroot/index.html
      Resources/Raw/wwwroot/_hpdos/...
    The HybridWebView SchemeHandler resolves:
      NSBundle.MainBundle.ResourcePath + "/" + HybridRoot ("wwwroot")
    which is Contents/Resources/wwwroot/ — matching exactly.
  -->
  <ItemGroup>
    <MauiAsset Include="../HPDOS.Core/wwwroot/**"
               LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    HpdRecorder.xcframework — Swift/ScreenCaptureKit recording bridge.
    Built by: Platforms/MacCatalyst/Recording/build-xcframework.sh
    The xcframework must be built and checked in before the MAUI project compiles.
    Only included on maccatalyst — Windows build skips this entirely.
  -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'
             AND Exists('Platforms/MacCatalyst/Recording/libHpdRecorder.xcframework')">
    <NativeReference Include="Platforms/MacCatalyst/Recording/libHpdRecorder.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

  <!--
    ASP.NET Core shared framework DLLs — macCatalyst has no shared framework.
    Directory.Build.targets strips the FrameworkReference for MAUI TFMs.
    We include the DLLs explicitly so they land in MonoBundle/.
  -->
  <PropertyGroup>
    <_AspNetCoreSharedFx>/usr/local/share/dotnet/shared/Microsoft.AspNetCore.App/10.0.2</_AspNetCoreSharedFx>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(_AspNetCoreSharedFx)')">
    <BundleResource Include="$(_AspNetCoreSharedFx)/*.dll"
                    PublishFolderType="Assembly"
                    Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
