<Project>

  <!--
    Remove the Microsoft.AspNetCore.App FrameworkReference when building for MAUI platform targets
    (maccatalyst, windows-via-MAUI). These platforms don't have an ASP.NET Core runtime pack.
    The Kestrel code in HPDOS.Core runs on the host OS process — it doesn't execute inside
    the MAUI platform sandbox — so we only need the ref assemblies at compile time, not at publish.

    For HPDOS.Core itself (net10.0), this target does nothing: the TargetPlatformIdentifier is empty
    and the FrameworkReference remains present and valid.
  -->
  <!--
    ResolveRuntimePackAssets reads @(FrameworkReference) and errors when it can't find a runtime pack
    for the current RID. For MAUI platform TFMs (maccatalyst, windows-via-MAUI), there is no
    Microsoft.AspNetCore.App runtime pack — the FrameworkReference flows transitively from HPDOS.Core
    via the project reference in project.assets.json.

    Running AfterTargets="ResolveFrameworkReferences" ensures the items are populated by the time
    we remove them, but before ResolveRuntimePackAssets tries to find the runtime pack.
  -->
  <Target Name="_RemoveAspNetCoreFrameworkRefForMauiPlatforms"
          AfterTargets="ResolveFrameworkReferences"
          BeforeTargets="ResolveRuntimePackAssets"
          Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'maccatalyst' OR
                     '$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
    <ItemGroup>
      <FrameworkReference Remove="Microsoft.AspNetCore.App" />
      <!-- ResolvedFrameworkReference is the resolved form produced by ResolveFrameworkReferences.
           RuntimeComponentManifest.targets reads this item and requires RuntimePackPath metadata.
           Without a runtime pack for maccatalyst/windows, we remove the resolved item too. -->
      <ResolvedFrameworkReference Remove="Microsoft.AspNetCore.App" />
    </ItemGroup>
  </Target>

</Project>
