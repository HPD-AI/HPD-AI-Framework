# HPDOS CLI Configuration
# Copy to .env or set in environment before running 'hpdos' CLI

# ============================================================================
# HPDOS Settings
# ============================================================================

# Port for Kestrel backend server (if not using remote server)
HPDOS_PORT=5173

# Maximum agentic iterations per session
HPDOS_MAX_TURNS=50

# LLM Provider (e.g., "anthropic", "openrouter", "openai", "ollama")
HPDOS_PROVIDER_KEY=anthropic

# Model ID for the selected provider
# Examples:
#   anthropic: claude-opus, claude-sonnet, claude-haiku
#   openrouter: z-ai/glm-4.6, anthropic/claude-opus
#   openai: gpt-4, gpt-3.5-turbo
#   ollama: llama2, mistral
HPDOS_MODEL_ID=claude-sonnet-4-6

# ============================================================================
# Provider API Keys
# ============================================================================

# Anthropic API Key (starts with "sk-ant-")
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API Key (starts with "sk-or-")
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI API Key (starts with "sk-")
OPENAI_API_KEY=sk-...

# Azure AI (Deployment)
AZURE_AI_API_KEY=...
AZURE_ENDPOINT=https://your-resource.openai.azure.com/

# Google AI API Key
GOOGLE_AI_API_KEY=...

# Mistral API Key
MISTRAL_API_KEY=...

# HuggingFace API Token
HUGGINGFACE_API_KEY=...

# Ollama Endpoint (if running locally)
OLLAMA_ENDPOINT=http://localhost:11434

# AWS Bedrock Region
AWS_REGION=us-east-1

# ============================================================================
# Optional Services
# ============================================================================

# ElevenLabs Text-to-Speech API Key
ELEVENLABS_API_KEY=...

# Tavily Search API Key
TAVILY_API_KEY=...

# ============================================================================
# Development
# ============================================================================

# Enable development mode (exposes internal endpoints, verbose logging)
HPDOS_DEV=0

# Log level: Debug, Information, Warning, Error
LOG_LEVEL=Information

# Enable verbose output
VERBOSE=0
