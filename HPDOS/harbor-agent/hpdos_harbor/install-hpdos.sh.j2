#!/bin/bash
set -euo pipefail

# Check if HPDOS is already available (pre-built in Docker image)
if command -v hpdos &>/dev/null; then
    echo "HPDOS already available in image"
    hpdos --version || echo "HPDOS ready"
    exit 0
fi

echo "Installing HPDOS dependencies..."

# Install dependencies
if command -v apt-get &>/dev/null; then
    apt-get update -qq && apt-get install -y --no-install-recommends \
        curl ca-certificates python3 libssl-dev libicu-dev \
        && rm -rf /var/lib/apt/lists/*
elif command -v apk &>/dev/null; then
    apk add --no-cache curl ca-certificates python3 bash icu-libs libssl3
fi

# Install .NET 10 runtime
curl -fsSL https://dot.net/v1/dotnet-install.sh | bash -s -- \
    --channel 10.0 \
    --runtime dotnet \
    --install-dir /usr/local/dotnet

export DOTNET_ROOT=/usr/local/dotnet
export PATH="$DOTNET_ROOT:$PATH"

# If hpdos-publish exists, set it up
if [ -d /usr/local/hpdos-publish ]; then
    chmod +x /usr/local/hpdos-publish/hpdos
    ln -sf /usr/local/hpdos-publish/hpdos /usr/local/bin/hpdos
    export LD_LIBRARY_PATH="/usr/local/hpdos-publish:$LD_LIBRARY_PATH"
    echo "HPDOS ready from /usr/local/hpdos-publish"
elif [ -d /usr/local/hpdos ]; then
    chmod +x /usr/local/hpdos/hpdos
    ln -sf /usr/local/hpdos/hpdos /usr/local/bin/hpdos
    export LD_LIBRARY_PATH="/usr/local/hpdos:$LD_LIBRARY_PATH"
    echo "HPDOS ready from /usr/local/hpdos"
fi

# Final check
if command -v hpdos &>/dev/null; then
    echo "HPDOS verified: $(hpdos --version 2>/dev/null || echo 'ok')"
else
    echo "Warning: HPDOS not found in PATH after installation"
fi
