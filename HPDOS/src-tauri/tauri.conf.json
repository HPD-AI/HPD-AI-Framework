{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HPDOS",
  "version": "0.1.0",
  "identifier": "com.hpd.hpdos",
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:* ws://127.0.0.1:*; frame-src http://127.0.0.1:*; connect-src http://127.0.0.1:* ws://127.0.0.1:*"
    },
    "withGlobalTauri": false
  },
  "build": {
    "frontendDist": "../src-dotnet/HPDOS.Core/wwwroot"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../src-dotnet/HPDOS.Core/bin/Release/net10.0/osx-arm64/publish/HPDOS.Core.dylib"]
  }
}
