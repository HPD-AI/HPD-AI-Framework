{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "paths": {
      "@hpd/hpd-agent-headless-ui": [
        "../HPD-AI-Framework/typescript/hpd-agent-headless-ui/dist/index.d.ts"
      ],
      "@hpd/hpd-agent-headless-ui/*": [
        "../HPD-AI-Framework/typescript/hpd-agent-headless-ui/dist/*/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}