{
  "name": "@hpd-research/hpd-agent-headless-ui",
  "version": "0.1.0",
  "description": "Framework-neutral branch state primitives for HPD-Agent UI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "hpd-agent",
    "agent",
    "ai",
    "ui",
    "headless",
    "typescript"
  ],
  "author": "HPD-AI",
  "license": "MIT",
  "dependencies": {
    "@hpd-research/hpd-agent-client": "file:../hpd-agent-client"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
