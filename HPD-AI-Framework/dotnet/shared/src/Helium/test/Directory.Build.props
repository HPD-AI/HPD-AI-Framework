<Project>
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NuGetPackageRoot)xunit.runner.visualstudio\2.8.2\build\net6.0\xunit.runner.visualstudio.testadapter.dll"
          Link="xunit.runner.visualstudio.testadapter.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(NuGetPackageRoot)xunit.runner.visualstudio\2.8.2\build\net6.0\xunit.runner.visualstudio.testadapter.dll')" />
    <None Include="$(NuGetPackageRoot)xunit.runner.visualstudio\2.8.2\build\net6.0\xunit.runner.reporters.netcoreapp10.dll"
          Link="xunit.runner.reporters.netcoreapp10.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(NuGetPackageRoot)xunit.runner.visualstudio\2.8.2\build\net6.0\xunit.runner.reporters.netcoreapp10.dll')" />
    <None Include="$(NuGetPackageRoot)xunit.runner.visualstudio\2.8.2\build\net6.0\xunit.runner.utility.netcoreapp10.dll"
          Link="xunit.runner.utility.netcoreapp10.dll"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          Condition="Exists('$(NuGetPackageRoot)xunit.runner.visualstudio\2.8.2\build\net6.0\xunit.runner.utility.netcoreapp10.dll')" />
  </ItemGroup>
</Project>
