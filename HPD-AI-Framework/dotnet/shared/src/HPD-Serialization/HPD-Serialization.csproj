<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Inherits TargetFrameworks from Directory.Build.props: net10.0;net9.0;net8.0 -->
    <RootNamespace>HPD.Serialization</RootNamespace>
    <AssemblyName>HPD.Serialization</AssemblyName>
    <IsPackable>true</IsPackable>

    <!-- Native AOT Configuration -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <PackageId>HPD-Serialization</PackageId>
    <Description>AOT-safe JSON/YAML config serialization helpers for HPD libraries.</Description>
    <PackageTags>serialization;config;json;yaml;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.*" />
  </ItemGroup>

</Project>
