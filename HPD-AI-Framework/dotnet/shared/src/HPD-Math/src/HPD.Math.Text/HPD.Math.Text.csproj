<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Math.Text</RootNamespace>
    <AssemblyName>HPD.Math.Text</AssemblyName>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PackageId>HPD-Math.Text</PackageId>
    <Description>Parsing and formatting adapters for HPD-Math kept outside the hot-path kernel.</Description>
    <PackageTags>math;formatting;parsing;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD.Math.Core\HPD.Math.Core.csproj" />
    <ProjectReference Include="..\HPD.Math.Finite\HPD.Math.Finite.csproj" />
    <ProjectReference Include="..\HPD.Math.Algebra\HPD.Math.Algebra.csproj" />
  </ItemGroup>

</Project>
