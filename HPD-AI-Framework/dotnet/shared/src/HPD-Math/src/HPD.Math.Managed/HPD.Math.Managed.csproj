<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Math.Managed</RootNamespace>
    <AssemblyName>HPD.Math.Managed</AssemblyName>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PackageId>HPD-Math.Managed</PackageId>
    <Description>Optional owned heap-backed convenience wrappers for HPD-Math kernels.</Description>
    <PackageTags>math;managed;convenience;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD.Math.Core\HPD.Math.Core.csproj" />
    <ProjectReference Include="..\HPD.Math.Finite\HPD.Math.Finite.csproj" />
    <ProjectReference Include="..\HPD.Math.Algebra\HPD.Math.Algebra.csproj" />
  </ItemGroup>

</Project>
