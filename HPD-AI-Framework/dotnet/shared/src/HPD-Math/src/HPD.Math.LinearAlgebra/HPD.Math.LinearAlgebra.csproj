<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Math.LinearAlgebra</RootNamespace>
    <AssemblyName>HPD.Math.LinearAlgebra</AssemblyName>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PackageId>HPD-Math.LinearAlgebra</PackageId>
    <Description>Allocation-free dense vector and matrix kernels for HPD-Math.</Description>
    <PackageTags>math;linear-algebra;matrix;vector;native-aot;zero-allocation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD.Math.Core\HPD.Math.Core.csproj" />
  </ItemGroup>

</Project>
