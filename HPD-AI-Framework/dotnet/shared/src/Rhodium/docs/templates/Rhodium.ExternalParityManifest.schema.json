{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hpd.local/rhodium/external-parity-manifest.schema.json",
  "title": "Rhodium External Parity Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ReportVersion",
    "Passed",
    "Provider",
    "DatasetId",
    "GitCommit",
    "AcceptedLimitations",
    "UnsupportedFeatures",
    "Mismatches",
    "Fixtures"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "ReportVersion": {
      "const": 1
    },
    "Passed": {
      "const": true
    },
    "Provider": {
      "type": "string",
      "minLength": 1
    },
    "DatasetId": {
      "type": "string",
      "minLength": 1
    },
    "GitCommit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{12,40}$"
    },
    "AcceptedLimitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "UnsupportedFeatures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "Mismatches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mismatch"
      }
    },
    "Fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    }
  },
  "$defs": {
    "artifactPath": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name",
        "Description",
        "Classification"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1
        },
        "Description": {
          "type": "string",
          "minLength": 1
        },
        "Classification": {
          "enum": [
            "ProviderDataAmbiguity",
            "PolicyDifference",
            "UnsupportedFeature"
          ]
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Name",
        "FixtureKind",
        "Provider",
        "DatasetId",
        "ExpectedResultSource",
        "CoveredDateRange",
        "InstrumentSet",
        "AccountType",
        "Passed",
        "InputArtifactPath",
        "InputArtifactSha256",
        "OutputArtifactPath",
        "OutputArtifactSha256",
        "ComparisonReportPath",
        "ComparisonReportSha256"
      ],
      "properties": {
        "Name": {
          "type": "string",
          "minLength": 1
        },
        "FixtureKind": {
          "enum": [
            "TradingCalendar",
            "AccountStatement",
            "MarginLiquidationFinancing",
            "MarketReplayExecution",
            "VenueOrderPolicy",
            "CrossVenueRouting"
          ]
        },
        "Provider": {
          "type": "string",
          "minLength": 1
        },
        "DatasetId": {
          "type": "string",
          "minLength": 1
        },
        "ExpectedResultSource": {
          "type": "string",
          "minLength": 1
        },
        "CoveredDateRange": {
          "type": "string",
          "minLength": 1
        },
        "InstrumentSet": {
          "type": "string",
          "minLength": 1
        },
        "AccountType": {
          "type": "string",
          "minLength": 1
        },
        "Passed": {
          "const": true
        },
        "InputArtifactPath": {
          "$ref": "#/$defs/artifactPath"
        },
        "InputArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "OutputArtifactPath": {
          "$ref": "#/$defs/artifactPath"
        },
        "OutputArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "ComparisonReportPath": {
          "$ref": "#/$defs/artifactPath"
        },
        "ComparisonReportSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
