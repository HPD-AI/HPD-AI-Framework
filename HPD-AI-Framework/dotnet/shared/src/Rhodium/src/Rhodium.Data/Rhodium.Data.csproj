<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Rhodium.Data</PackageId>
    <Description>Market data abstractions, stores, aggregators, catalogs, and feed primitives for Rhodium quantitative finance applications.</Description>
    <PackageTags>finance;financial;trading;algorithmic-trading;quant;quantitative-finance;market-data;timeseries;ohlcv;quotes;trades;bars;aggregators;data-feed;hft;low-latency;backtesting;analytics</PackageTags>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rhodium.Core\Rhodium.Core.csproj" />
  </ItemGroup>

</Project>
