<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>Rhodium.Analyzers</PackageId>
    <Description>Roslyn analyzers for Rhodium strategy, runtime, finance, and low-latency trading code.</Description>
    <PackageTags>finance;financial;trading;algorithmic-trading;quant;quantitative-finance;hft;high-frequency-trading;low-latency;roslyn;analyzers;code-analysis;source-analysis;strategy;backtesting</PackageTags>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128;RS1036;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="IncludeAnalyzerPackageFiles" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <None Include="bin/$(Configuration)/netstandard2.0/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <None Include="bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.dll')" />
      <None Include="bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('bin/$(Configuration)/netstandard2.0/Microsoft.CodeAnalysis.CSharp.dll')" />
    </ItemGroup>
  </Target>

</Project>
