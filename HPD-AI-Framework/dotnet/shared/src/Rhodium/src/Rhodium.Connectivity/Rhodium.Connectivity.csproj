<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Rhodium.Connectivity</PackageId>
    <Description>Connectivity abstractions and policy feeds for Rhodium market data, execution, financing, and trading system integrations.</Description>
    <PackageTags>finance;financial;trading;algorithmic-trading;quant;quantitative-finance;connectivity;market-data;execution;broker;exchange;feed;hft;low-latency;policy;financing;simulation;backtesting</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rhodium.Core\Rhodium.Core.csproj" />
    <ProjectReference Include="..\Rhodium.Data\Rhodium.Data.csproj" />
    <ProjectReference Include="..\Rhodium.Simulation\Rhodium.Simulation.csproj" />
    <ProjectReference Include="..\..\..\HPD-Events\HPD-Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\PolicyFeeds\*.csv" />
    <EmbeddedResource Include="Data\FinancingFeeds\*.csv" />
  </ItemGroup>

</Project>
