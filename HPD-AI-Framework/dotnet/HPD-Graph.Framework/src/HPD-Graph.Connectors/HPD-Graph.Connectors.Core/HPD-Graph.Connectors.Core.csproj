<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Inherits TargetFrameworks from Directory.Build.props: net10.0;net9.0;net8.0 -->
    <RootNamespace>HPD.Graph.Connectors.Core</RootNamespace>
    <AssemblyName>HPD.Graph.Connectors.Core</AssemblyName>
    <IsPackable>true</IsPackable>

    <PackageId>HPD-Graph.Connectors.Core</PackageId>
    <Description>Runtime services for HPD-Graph automation and data connectors.</Description>
    <PackageTags>graph;workflow;connectors;automation;data-orchestration;runtime</PackageTags>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD-Graph.Connectors.Abstractions\HPD-Graph.Connectors.Abstractions.csproj" />
    <ProjectReference Include="..\..\HPD-Graph.Hosting\HPD-Graph.Hosting.csproj" />
    <ProjectReference Include="../../../../shared/src/HPD-Events/HPD-Events.csproj" />
  </ItemGroup>

</Project>
