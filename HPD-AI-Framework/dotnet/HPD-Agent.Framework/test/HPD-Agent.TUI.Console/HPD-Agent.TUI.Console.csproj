    <ProjectReference Include="../../src/HPD-Agent.ModelsDev/HPD-Agent.ModelsDev.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.Providers/HPD-Agent.Providers.Anthropic/HPD-Agent.Providers.Anthropic.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.Providers/HPD-Agent.Providers.AzureAI/HPD-Agent.Providers.AzureAI.csproj" />
    <ProjectReference Include="../../src/HPD-Agent.Providers/HPD-Agent.Providers.Bedrock/HPD-Agent.Providers.Bedrock.csproj" />
