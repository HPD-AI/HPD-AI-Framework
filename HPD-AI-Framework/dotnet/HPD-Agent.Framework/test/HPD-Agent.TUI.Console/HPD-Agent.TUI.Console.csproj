<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Agent.TUI.Console</RootNamespace>
    <AssemblyName>HPD-Agent.TUI.Console</AssemblyName>
    <UserSecretsId>hpd-agent-tui-console</UserSecretsId>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;HPDAUDIO001;MEAI001;IL2026;IL3050</NoWarn>
