<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Agent.Sandbox</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Sandbox.Core</PackageId>
    <Description>Shared sandbox policy, contracts, state, network mediation, and OS-family enforcement for HPD Agent.</Description>
    <PackageTags>sandbox;policy;process-isolation;security;network;bwrap;bubblewrap;sandbox-exec;seatbelt;seccomp;bpf</PackageTags>
    <BuildSeccompHelpers Condition="'$(BuildSeccompHelpers)' == ''">true</BuildSeccompHelpers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../../../shared/src/HPD-Events/HPD-Events.csproj" />

    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Agent.Sandbox.Core.Tests" />
    <InternalsVisibleTo Include="HPD-Agent.Sandbox.Local.Tests" />
  </ItemGroup>

  <Target Name="BuildSeccompHelpersForLinux"
          BeforeTargets="AssignTargetPaths;GenerateNuspec"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(BuildSeccompHelpers)' == 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/build.sh&quot;" />

    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-x64"
               Condition="Exists('$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-x64')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Pack>true</Pack>
        <PackagePath>runtimes/linux-x64/native/</PackagePath>
        <TargetPath>runtimes/linux-x64/native/apply-seccomp-x64</TargetPath>
      </Content>
      <Content Include="$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-arm64"
               Condition="Exists('$(MSBuildProjectDirectory)/Platforms/Linux/Seccomp/native/bin/apply-seccomp-arm64')">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Pack>true</Pack>
        <PackagePath>runtimes/linux-arm64/native/</PackagePath>
        <TargetPath>runtimes/linux-arm64/native/apply-seccomp-arm64</TargetPath>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="Platforms/Linux/Seccomp/native/*.c">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/native-src</PackagePath>
    </Content>
    <Content Include="Platforms/Linux/Seccomp/native/build.sh">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>true</Pack>
      <PackagePath>contentFiles/any/any/native-src</PackagePath>
    </Content>
  </ItemGroup>
</Project>
