<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.Audio</RootNamespace>
    <AssemblyName>HPD.Agent.Audio.Abstractions</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Audio.Abstractions</PackageId>
    <Description>Public audio runtime contracts for HPD Agent audio.</Description>
    <PackageTags>ai;agent;audio;abstractions;realtime</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../shared/src/HPD-RealtimeMedia/src/HPD.Audio.Primitives/HPD.Audio.Primitives.csproj" />
  </ItemGroup>

</Project>
