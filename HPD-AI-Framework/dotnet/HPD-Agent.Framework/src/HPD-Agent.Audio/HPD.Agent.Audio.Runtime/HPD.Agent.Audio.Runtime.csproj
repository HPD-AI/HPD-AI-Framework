<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.Audio.Runtime</RootNamespace>
    <AssemblyName>HPD.Agent.Audio.Runtime</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Audio.Runtime</PackageId>
    <Description>Deterministic runtime and fake implementations for the HPD Agent audio content-input proof slice.</Description>
    <PackageTags>ai;agent;audio;runtime;testing;content-input</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.4.1" />
    <ProjectReference Include="../HPD.Agent.Audio.Abstractions/HPD.Agent.Audio.Abstractions.csproj" />
  </ItemGroup>

</Project>
