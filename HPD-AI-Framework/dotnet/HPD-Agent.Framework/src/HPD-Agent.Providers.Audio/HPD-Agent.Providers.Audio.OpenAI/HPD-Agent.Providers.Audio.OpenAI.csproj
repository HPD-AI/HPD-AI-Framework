<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.Agent.Providers.Audio.OpenAI</RootNamespace>
    <AssemblyName>HPD.Agent.Providers.Audio.OpenAI</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Agent.Providers.Audio.OpenAI</PackageId>
    <Description>OpenAI audio provider adapters for HPD Agent audio.</Description>
    <PackageTags>ai;agent;audio;openai;stt;tts</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);1591;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
    <PackageReference Include="OpenAI" Version="2.11.0" />
    <ProjectReference Include="../../HPD-Agent.Audio/HPD-Agent.Audio.csproj" />
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
  </ItemGroup>

</Project>
