<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <RootNamespace>HPD.Agent.TextExtraction</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8604;RS2008;CS0628;CA2024;MEAI001</NoWarn>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>HPD-Agent.TextExtraction</PackageId>
    <Description>HPD Agent document handling middleware and builder extensions powered by HPD-TextExtract.</Description>
    <PackageTags>agent;middleware;text-extraction;document;hpd-text-extract</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Agent/HPD-Agent.csproj" />
    <ProjectReference Include="../../../shared/src/HPD-TextExtract/HPD-TextExtract.csproj" />
  </ItemGroup>

</Project>
