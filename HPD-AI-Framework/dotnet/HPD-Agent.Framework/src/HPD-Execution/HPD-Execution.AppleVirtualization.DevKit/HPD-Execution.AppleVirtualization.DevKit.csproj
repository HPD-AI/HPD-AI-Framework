<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Execution.AppleVirtualization.DevKit</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Execution.AppleVirtualization.DevKit</PackageId>
    <Description>Developer and test utilities for HPD Apple Virtualization prepared images and real acceptance runs.</Description>
    <PackageTags>hpd;execution;apple;virtualization;devkit;acceptance</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HPD-Execution.Contracts/HPD-Execution.Contracts.csproj" />
  </ItemGroup>
</Project>
