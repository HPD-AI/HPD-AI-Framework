<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <RootNamespace>HPD.Execution.AppleVirtualization</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-Execution.AppleVirtualization</PackageId>
    <Description>Apple Virtualization.framework execution provider for HPD Agent using a supervised hpd-vz helper.</Description>
    <PackageTags>execution;apple;virtualization;macos;vm;microvm;hpd-vz</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../HPD-Agent/HPD-Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HPD-Execution.AppleVirtualization.Tests" />
  </ItemGroup>
</Project>
