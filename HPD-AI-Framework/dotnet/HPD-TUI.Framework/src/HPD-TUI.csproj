<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HPD.TUI</RootNamespace>
    <AssemblyName>HPD.TUI</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>HPD-TUI</PackageId>
    <Description>High-performance terminal UI primitives for the HPD ecosystem.</Description>
    <PackageTags>terminal;tui;aot;console;rendering</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.2.0" />
  </ItemGroup>

</Project>
