<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HPD.Math.Finite</RootNamespace>
    <AssemblyName>HPD.Math.Finite</AssemblyName>
    <LangVersion>preview</LangVersion>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <PackageId>HPD-Math.Finite</PackageId>
    <Description>Finite enumeration and finite-support kernel primitives for HPD-Math.</Description>
    <PackageTags>math;finite-support;native-aot;zero-allocation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HPD.Math.Core\HPD.Math.Core.csproj" />
  </ItemGroup>

</Project>
